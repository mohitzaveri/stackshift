# Copy this file to .env.local and fill in what you need.

# Required for real analyses. Create a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional. Raises GitHub's limit from 60 to 5,000 requests per hour (read-only is enough).
GITHUB_TOKEN=

# Optional. Set to 1 to let visitors analyze private repositories the token can read.
# Keep it off on a public server, or anyone could read your private code through the app.
ALLOW_PRIVATE_REPOS=

# Optional. Claude model and effort level (low, medium, high, xhigh, max).
# claude-opus-5-5 (default) and claude-sonnet-5-5 support everything StackShift uses.
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=high

# Optional. Set to 1 to try the app without an API key: the repository is read
# for real, but the AI steps return labeled placeholders.
DEMO_MODE=

# Optional, for public deployments. Visitors must enter this code to run an analysis.
ACCESS_CODE=

# Optional. Analyses allowed per visitor per hour (0 turns the limit off).
RATE_LIMIT_PER_HOUR=5

# Optional. Analyses allowed per day for all visitors together: a hard cap on spending (0 = no cap).
DAILY_ANALYSIS_LIMIT=50
